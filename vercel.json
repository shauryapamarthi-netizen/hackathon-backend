{
  "version": 2,
  "builds": [
    { "src": "dist/**", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/health", "dest": "/api/index.js" },
    { "src": "/exercises", "dest": "/api/index.js" },
    { "src": "/next-exercise", "dest": "/api/index.js" },
    { "src": "/attempts", "dest": "/api/index.js" },
    { "src": "/chat", "dest": "/api/index.js" },
    { "src": "/simple/(.*)", "dest": "/public/$1" },
    { "src": "/simple", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/dist/$1" }
  ]
}
